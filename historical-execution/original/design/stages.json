    "W1": {
      "requires": [
        "E2",
        "W0"
      ],
      "outputs": [
        "paper/main.tex",
        "paper/sections/abstract.tex",
        "paper/sections/introduction.tex",
        "paper/sections/methods.tex",
        "paper/sections/results.tex",
        "paper/sections/discussion.tex",
        "paper/refs.bib",
        "paper/build/main.pdf",
        "paper/claims-to-results.tsv",
        "logs/W1-build.txt",
        "handoff/intake/W1.json",
        "logs/W1-intake.txt"
      ],
      "checks": [
        "claims_traceable",
        "actual_methods",
        "no_essential_placeholders",
        "bibliography_resolved",
        "pdf_compiled",
        "predecessor_output_evaluated"
