        "reviews/design-review.md"
      ],
      "checks": [
        "construct_identity",
        "endpoint_provenance",
        "visibility_design",
        "panel_and_metrics_frozen",
        "design_review"
      ]
    },
    "E1": {
      "requires": [
        "E0"
      ],
      "outputs": [
        "environment/model-manifest.json",
        "environment/qualification.json",
        "logs/E1-tests.txt",
        "design/execution-config.json",
        "scripts/run_experiments.py",
        "scripts/analyse_results.py"
      ],
      "checks": [
        "model_access_both",
        "coordinates",
        "causal_visibility",
        "numerical_repeatability",
