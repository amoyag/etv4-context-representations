    "W0": {
      "requires": [
        "E0",
        "E1"
      ],
      "outputs": [
        "handoff/W0-snapshot/introduction.tex",
        "handoff/W0-snapshot/refs.bib",
        "handoff/W0-snapshot/methods-plan.md",
        "handoff/W0-snapshot/literature-claims.tsv",
        "handoff/W0-snapshot/novelty-check.md",
        "handoff/W0-snapshot/figure-storyboard.md",
        "handoff/intake/W0.json",
        "logs/W0-intake.txt"
