{
  "schema_version": 1,
  "stages": {
    "E0": {
      "requires": [],
      "outputs": [
        "design/protocol-v1.md",
        "design/frozen-protocol.json",
        "design/run-plan.json",
        "data/derived/construct-registry.tsv",
        "data/derived/measurement-registry.tsv",
