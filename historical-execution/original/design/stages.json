        "E1"
      ],
      "outputs": [
        "results/coverage.json",
        "results/primary-metrics.tsv",
        "results/control-metrics.tsv",
        "results/report.md",
        "figures/fig1.pdf",
        "figures/fig2.pdf",
        "figures/fig3.pdf",
        "exports/results-v1/manifest.json",
        "logs/E2-verification.txt",
        "handoff/intake/E2.json",
        "logs/E2-intake.txt"
      ],
      "checks": [
        "core_matrix_complete",
        "frozen_design_respected",
        "control_coverage",
        "arithmetic_recomputed",
        "figures_from_data",
        "export_integrity",
        "predecessor_output_evaluated"
      ]
