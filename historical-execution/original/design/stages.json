    "R0": {
      "requires": [
        "W1"
      ],
      "outputs": [
        "reviews/scientific-review.md",
        "reviews/evidence-review.md",
        "reviews/disposition.json",
        "reviews/visual-check.md",
        "handoff/review-ready.json",
        "handoff/REVIEW-GUIDE.md",
        "handoff/section-3.5-candidate.md",
        "exports/review-mvp-v1/manifest.json",
        "exports/review-mvp-v1/manuscript.pdf",
        "logs/R0-verification.txt",
        "handoff/intake/R0.json",
        "logs/R0-intake.txt"
      ],
      "checks": [
        "scientific_review",
        "evidence_review",
        "central_findings_closed",
        "contribution_supported",
        "visual_inspection",
        "final_export_integrity",
        "author_review_guide",
        "predecessor_output_evaluated"
      ]
